#include <windows.h>
#include "Version.h"
#include <commctrl.h>
#include "resource.h"

#pragma code_page(65001)
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL

IDI_APP ICON "../tip/zhuyin.ico"

IDD_MAIN DIALOGEX 0, 0, 400, 282
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "微新注音設定"
FONT 9, "Microsoft JhengHei UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_TAB, WC_TABCONTROLW, WS_TABSTOP | WS_CLIPSIBLINGS, 7, 7, 386, 248

    LTEXT           "", IDC_PACKS_HINT, 16, 26, 368, 18
    CONTROL         "", IDC_PACKS_LIST, WC_LISTVIEWW, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 16, 46, 368, 200

    LTEXT           "", 1100, 16, 26, 368, 18
    EDITTEXT        1101, 16, 46, 150, 13, ES_AUTOHSCROLL
    CONTROL         "", 1102, WC_LISTVIEWW, LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 16, 63, 296, 183
    PUSHBUTTON      "新增(&A)…", 1103, 320, 63, 64, 14
    PUSHBUTTON      "修改(&E)…", 1104, 320, 81, 64, 14
    PUSHBUTTON      "刪除(&D)", 1105, 320, 99, 64, 14
    PUSHBUTTON      "匯入(&I)…", 1106, 320, 127, 64, 14
    PUSHBUTTON      "匯出(&X)…", 1107, 320, 145, 64, 14

    LTEXT           "", 1200, 16, 26, 368, 18
    EDITTEXT        1201, 16, 46, 150, 13, ES_AUTOHSCROLL
    CONTROL         "", 1202, WC_LISTVIEWW, LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 16, 63, 296, 183
    PUSHBUTTON      "新增(&A)…", 1203, 320, 63, 64, 14
    PUSHBUTTON      "修改(&E)…", 1204, 320, 81, 64, 14
    PUSHBUTTON      "刪除(&D)", 1205, 320, 99, 64, 14
    PUSHBUTTON      "匯入(&I)…", 1206, 320, 127, 64, 14
    PUSHBUTTON      "匯出(&X)…", 1207, 320, 145, 64, 14

    LTEXT           "", IDC_LEARN_HINT, 16, 26, 368, 18
    EDITTEXT        IDC_LEARN_SEARCH, 16, 46, 150, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_LEARN_LIST, WC_LISTVIEWW, LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 16, 63, 296, 183
    PUSHBUTTON      "忘記(&F)", IDC_LEARN_FORGET, 320, 63, 64, 14
    PUSHBUTTON      "改成自訂詞(&U)", IDC_LEARN_TOUSER, 320, 81, 64, 14
    PUSHBUTTON      "全部清除(&C)…", IDC_LEARN_CLEAR, 320, 109, 64, 14

    LTEXT           "", IDC_OPT_HINT, 16, 26, 368, 18
    AUTOCHECKBOX    "只打了注音（沒有其他字）時，按 Enter 直接輸出注音(&B)", IDC_OPT_ENTER_BOPOMOFO, 16, 48, 368, 12
    LTEXT           "", IDC_OPT_CTRL_HINT, 16, 68, 368, 18
    EDITTEXT        IDC_OPT_CTRL_SEARCH, 16, 88, 150, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_OPT_CTRL_LIST, WC_LISTVIEWW, LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 16, 105, 296, 141
    PUSHBUTTON      "全選(&S)", IDC_OPT_CTRL_ALL, 320, 105, 64, 14
    PUSHBUTTON      "全不選(&N)", IDC_OPT_CTRL_NONE, 320, 123, 64, 14
    PUSHBUTTON      "還原預設(&R)", IDC_OPT_CTRL_DEFAULT, 320, 151, 64, 14

    LTEXT           "", IDC_STATUS, 7, 262, 250, 10
    PUSHBUTTON      "開啟資料夾(&O)", IDC_OPEN_FOLDER, 264, 259, 66, 14
    PUSHBUTTON      "關閉", IDCANCEL, 336, 259, 57, 14
END

IDD_PHRASE DIALOGEX 0, 0, 270, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "自訂詞"
FONT 9, "Microsoft JhengHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "詞(&W)：", -1, 7, 9, 42, 10
    EDITTEXT        IDC_PH_VALUE, 52, 7, 211, 13, ES_AUTOHSCROLL
    LTEXT           "注音(&R)：", IDC_PH_LABEL_READING, 7, 27, 42, 10
    EDITTEXT        IDC_PH_READING, 52, 25, 211, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_PH_HINT, 52, 43, 211, 60
    DEFPUSHBUTTON   "確定", IDOK, 156, 109, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 213, 109, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ZY_VERSION_MAJOR,ZY_VERSION_MINOR,ZY_VERSION_PATCH,0
 PRODUCTVERSION ZY_VERSION_MAJOR,ZY_VERSION_MINOR,ZY_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040404b0"
        BEGIN
            VALUE "FileDescription", "微新注音設定"
            VALUE "FileVersion", ZY_VERSION_STRING
            VALUE "ProductName", "微新注音"
            VALUE "ProductVersion", ZY_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0404, 1200
    END
END
