#include <windows.h>
#include "Version.h"

#pragma code_page(65001)

// Must stay the first icon resource: Register.cpp registers the profile with icon index 0.
101 ICON "zhuyin.ico"
// Taskbar 中/英 indicator (LangBarButton.cpp)
102 ICON "mode_zh.ico"
103 ICON "mode_en.ico"
// The same in 全形 (full-width) mode: orange background
104 ICON "mode_zh_full.ico"
105 ICON "mode_en_full.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ZY_VERSION_MAJOR,ZY_VERSION_MINOR,ZY_VERSION_PATCH,0
 PRODUCTVERSION ZY_VERSION_MAJOR,ZY_VERSION_MINOR,ZY_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040404b0"
        BEGIN
            VALUE "FileDescription", "微新注音 輸入法"
            VALUE "FileVersion", ZY_VERSION_STRING
            VALUE "ProductName", "微新注音"
            VALUE "ProductVersion", ZY_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0404, 1200
    END
END
